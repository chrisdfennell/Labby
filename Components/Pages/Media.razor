@page "/media"
@rendermode InteractiveServer
@inject MediaHub Hub
@inject ILogger<Media> Logger
@implements IDisposable

<PageTitle>Labby — Media</PageTitle>

<div class="d-flex align-items-center flex-wrap gap-3 mb-4">
    <h1 class="mb-0">🎬 Media</h1>
    @if (Hub.SearchConfigured)
    {
        <div class="d-flex gap-2 ms-auto media-search">
            <input class="form-control form-control-sm" placeholder="Search movies & shows…"
                   @bind="_searchQuery" @bind:event="oninput" @onkeydown="OnSearchKeyDown" />
            <button class="btn btn-sm btn-outline-primary" disabled="@(_searching || string.IsNullOrWhiteSpace(_searchQuery))"
                    @onclick="SearchAsync">@(_searching ? "…" : "Search")</button>
        </div>
    }
</div>

@if (_search is not null)
{
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between">
            <span>🔎 Results for "@_lastQuery"</span>
            <button type="button" class="link-btn" @onclick="() => _search = null">close</button>
        </div>
        <div class="card-body">
            @foreach (var error in _search.Errors)
            {
                <div class="text-danger small">@error</div>
            }
            @if (_searchActionError is not null)
            {
                <div class="text-danger small">@_searchActionError</div>
            }
            @if (_search.Results.Count == 0 && _search.Errors.Count == 0)
            {
                <span class="text-muted">Nothing found.</span>
            }
            @foreach (var group in _search.Results.GroupBy(r => r.Source).OrderBy(g => SourceOrder(g.Key)))
            {
                <div class="search-group">
                    <div class="d-flex align-items-center flex-wrap gap-2 search-group-head">
                        <span class="fw-semibold small">@SourceIcon(group.Key) @group.Key</span>
                        @if (_arr.TryGetValue(group.Key, out var target))
                        {
                            @if (target.Targets is null)
                            {
                                <span class="text-muted small">loading folders…</span>
                            }
                            else if (target.Targets.Error is { } targetError)
                            {
                                <span class="text-danger small">@targetError</span>
                            }
                            else
                            {
                                <select class="form-select form-select-sm dl-add-target" aria-label="Root folder" @bind="target.Root">
                                    @foreach (var folder in target.Targets.RootFolders)
                                    {
                                        <option value="@folder">@folder</option>
                                    }
                                </select>
                                <select class="form-select form-select-sm dl-add-target" aria-label="Quality profile" @bind="target.ProfileId">
                                    @foreach (var profile in target.Targets.QualityProfiles)
                                    {
                                        <option value="@profile.Id">@profile.Name</option>
                                    }
                                </select>
                            }
                        }
                    </div>
                    @foreach (var r in group)
                    {
                        <div class="media-upcoming d-flex justify-content-between align-items-center gap-2">
                            <span class="text-truncate">
                                <span class="fw-semibold">@r.Title</span>
                                <span class="text-muted">@(r.Year is { } y ? $"({y})" : "")</span>
                                <span class="badge bg-secondary ms-1">@r.Type</span>
                            </span>
                            <span class="text-nowrap">
                                @if (_actedOn.Contains(r.Key))
                                {
                                    <span class="badge bg-success">@(r.Source == "Overseerr" ? "requested ✓" : "added ✓")</span>
                                }
                                else if (r.Status is { } status)
                                {
                                    <span class="badge bg-success">@status</span>
                                }
                                else if (r.Source == "Overseerr")
                                {
                                    <button type="button" class="req-btn approve" disabled="@_searchActionBusy"
                                            @onclick="() => RequestAsync(r)">+ request</button>
                                }
                                else
                                {
                                    <button type="button" class="req-btn approve" title="Add to @r.Source, monitored, and search for it now"
                                            disabled="@(_searchActionBusy || !CanAdd(r))" @onclick="() => AddToArrAsync(r)">+ add</button>
                                }
                            </span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

@if (!Hub.AnyConfigured)
{
    <div class="alert alert-warning">
        No media services configured. Set URLs and API keys under <code>Media</code> in <code>appsettings.json</code>
        (or the <code>TAUTULLI_*</code>, <code>SONARR_*</code>, <code>RADARR_*</code>, <code>QBITTORRENT_*</code>,
        <code>NZBGET_*</code>, <code>OVERSEERR_*</code> variables in <code>.env</code>).
    </div>
}
else
{
    <div class="row g-3">
        @if (Hub.TautulliConfigured)
        {
            <div class="col-lg-6">
                <div class="card h-100">
                    <div class="card-header">▶️ Now playing @(_nowPlaying?.Sessions.Count is > 0 and var n ? $"— {n}" : "")</div>
                    <div class="card-body">
                        @if (_nowPlaying is null)
                        {
                            <span class="text-muted">Loading…</span>
                        }
                        else if (_nowPlaying.Error is not null)
                        {
                            <span class="text-danger small">Tautulli: @_nowPlaying.Error</span>
                        }
                        else if (_nowPlaying.Sessions.Count == 0)
                        {
                            <span class="text-muted">Nothing streaming right now.</span>
                        }
                        else
                        {
                            @if (_killError is not null)
                            {
                                <div class="text-danger small">@_killError</div>
                            }
                            @foreach (var s in _nowPlaying.Sessions)
                            {
                                <div class="media-session">
                                    <div class="d-flex justify-content-between align-items-baseline gap-2">
                                        <span class="fw-semibold text-truncate">@(s.State == "paused" ? "⏸" : "▶") @s.Title</span>
                                        <span class="text-nowrap">
                                            <span class="badge bg-secondary">@s.Decision</span>
                                            @if (s.SessionKey is { Length: > 0 })
                                            {
                                                @if (_confirmKill == s.SessionKey)
                                                {
                                                    <button type="button" class="req-btn decline" @onclick="() => KillStreamAsync(s)">confirm stop</button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="req-btn decline" title="Stop this stream"
                                                            @onclick="() => _confirmKill = s.SessionKey">✗</button>
                                                }
                                            }
                                        </span>
                                    </div>
                                    <div class="text-muted small">@s.User · @s.Player</div>
                                    <div class="progress media-progress" role="progressbar" aria-label="Playback progress"
                                         aria-valuenow="@((int)s.ProgressPercent)" aria-valuemin="0" aria-valuemax="100">
                                        <div class="progress-bar bg-success" style="width: @((int)s.ProgressPercent)%"></div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        }
        @if (Hub.DownloadsConfigured)
        {
            <div class="col-lg-6">
                <div class="card h-100">
                    <div class="card-header d-flex justify-content-between">
                        <span>⬇️ Downloads</span>
                        @if (_downloads is not null)
                        {
                            <span>↓ @Format.Bytes(_downloads.DownloadBps)/s · ↑ @Format.Bytes(_downloads.UploadBps)/s</span>
                        }
                    </div>
                    <div class="card-body">
                        @if (_downloads is null)
                        {
                            <span class="text-muted">Loading…</span>
                        }
                        else
                        {
                            @if (_downloads.QbitError is not null)
                            {
                                <div class="text-danger small">qBittorrent: @_downloads.QbitError</div>
                            }
                            @if (_downloads.NzbgetError is not null)
                            {
                                <div class="text-danger small">NZBGet: @_downloads.NzbgetError</div>
                            }
                            @if (_downloads.Items.Count == 0 && _downloads.QbitError is null && _downloads.NzbgetError is null)
                            {
                                <span class="text-muted">No active downloads.</span>
                            }
                            <div class="d-flex flex-wrap gap-2 mb-2 mt-1">
                                <input class="form-control form-control-sm dl-add-input" placeholder="Paste magnet / torrent / NZB link…"
                                       @bind="_addLink" @bind:event="oninput" />
                                <select class="form-select form-select-sm dl-add-target" @bind="_addTarget">
                                    <option value="auto">auto</option>
                                    <option>qBittorrent</option>
                                    <option>NZBGet</option>
                                </select>
                                <button class="btn btn-sm btn-outline-primary" disabled="@(_adding || string.IsNullOrWhiteSpace(_addLink))"
                                        @onclick="AddDownloadAsync">@(_adding ? "adding…" : _added ? "added ✓" : "add")</button>
                            </div>
                            @if (_addError is not null)
                            {
                                <div class="text-danger small">@_addError</div>
                            }
                            @if (_downloadActionError is not null)
                            {
                                <div class="text-danger small">@_downloadActionError</div>
                            }
                            @foreach (var d in _downloads.Items)
                            {
                                <div class="media-session">
                                    <div class="d-flex justify-content-between align-items-baseline gap-2">
                                        <span class="text-truncate" title="@d.Name">@d.Name</span>
                                        <span class="text-nowrap">
                                            <span class="text-muted small">@Format.Bytes(d.SpeedBps)/s</span>
                                            @if (d.Id is { Length: > 0 })
                                            {
                                                <button type="button" class="dl-toggle" title="@(d.IsPaused ? "Resume" : "Pause")"
                                                        disabled="@_downloadActionBusy" @onclick="() => TogglePauseAsync(d)">
                                                    @(d.IsPaused ? "▶" : "⏸")
                                                </button>
                                            }
                                        </span>
                                    </div>
                                    <div class="text-muted small">
                                        @d.Source · @d.State · @Format.Bytes(d.SizeBytes)
                                        @(d.Eta is { } eta ? $" · {Format.ShortDuration(eta)} left" : "")
                                    </div>
                                    <div class="progress media-progress" role="progressbar" aria-label="Download progress"
                                         aria-valuenow="@((int)d.ProgressPercent)" aria-valuemin="0" aria-valuemax="100">
                                        <div class="progress-bar" style="width: @((int)d.ProgressPercent)%"></div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        }
        @if (Hub.SonarrConfigured || Hub.RadarrConfigured)
        {
            <div class="col-lg-6">
                <div class="card h-100">
                    <div class="card-header">📥 Arr queue</div>
                    <div class="card-body">
                        @if (_queue is null)
                        {
                            <span class="text-muted">Loading…</span>
                        }
                        else
                        {
                            @if (_queue.SonarrError is not null)
                            {
                                <div class="text-danger small">Sonarr: @_queue.SonarrError</div>
                            }
                            @if (_queue.RadarrError is not null)
                            {
                                <div class="text-danger small">Radarr: @_queue.RadarrError</div>
                            }
                            @if (_queue.Items.Count == 0 && _queue.SonarrError is null && _queue.RadarrError is null)
                            {
                                <span class="text-muted">Queue is empty.</span>
                            }
                            @if (_queueActionError is not null)
                            {
                                <div class="text-danger small">@_queueActionError</div>
                            }
                            @foreach (var q in _queue.Items)
                            {
                                <div class="media-session">
                                    <div class="d-flex justify-content-between align-items-baseline gap-2">
                                        <span class="text-truncate" title="@q.Title">@(q.HasProblem ? "⚠️ " : "")@q.Title</span>
                                        <span class="text-nowrap">
                                            <span class="badge @(q.HasProblem ? "bg-warning text-dark" : "bg-secondary")">@q.Status</span>
                                            @if (q.Id > 0)
                                            {
                                                @if (_confirmRetry == $"{q.Source}:{q.Id}")
                                                {
                                                    <button type="button" class="req-btn decline" disabled="@_queueActionBusy"
                                                            @onclick="() => RetryQueueItemAsync(q)">confirm: blocklist + search again</button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="req-btn approve" title="Remove, blocklist this release, and search for another"
                                                            disabled="@_queueActionBusy" @onclick='() => _confirmRetry = $"{q.Source}:{q.Id}"'>🔁</button>
                                                }
                                            }
                                        </span>
                                    </div>
                                    <div class="text-muted small">
                                        @q.Source · @Format.Bytes(q.SizeBytes)
                                        @(q.TimeLeft is { } tl ? $" · {tl} left" : "")
                                    </div>
                                    @if (q.ErrorMessage is { } problem)
                                    {
                                        <div class="state-warn small text-truncate" title="@problem">@problem</div>
                                    }
                                    <div class="progress media-progress" role="progressbar" aria-label="Queue progress"
                                         aria-valuenow="@((int)q.ProgressPercent)" aria-valuemin="0" aria-valuemax="100">
                                        <div class="progress-bar" style="width: @((int)q.ProgressPercent)%"></div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        }
        @if (Hub.ErsatzTvConfigured)
        {
            <div class="col-lg-6">
                <div class="card h-100">
                    <div class="card-header d-flex justify-content-between">
                        <span>
                            📡 ErsatzTV
                            @(_ersatzTv?.Channels.Count is > 0 and var n ? $"— {n} channel{(n == 1 ? "" : "s")}" : "")
                            @if (_ersatzTv?.StreamingCount is > 0 and var watching)
                            {
                                <span class="badge bg-success ms-1">@watching watching</span>
                            }
                        </span>
                        @if (_ersatzTv?.Version is { Length: > 0 } version)
                        {
                            <span class="text-muted small">@version</span>
                        }
                    </div>
                    <div class="card-body missing-list">
                        @if (_ersatzTv is null)
                        {
                            <span class="text-muted">Loading…</span>
                        }
                        else if (_ersatzTv.Error is not null)
                        {
                            <span class="text-danger small">ErsatzTV: @_ersatzTv.Error</span>
                        }
                        else if (_ersatzTv.Channels.Count == 0)
                        {
                            <span class="text-muted">No channels configured yet.</span>
                        }
                        else
                        {
                            @if (_ersatzTv.DetailError is { } detailError)
                            {
                                <div class="state-warn small">⚠ Guide unavailable: @detailError</div>
                            }
                            @if (_ersatzTvActionError is not null)
                            {
                                <div class="text-danger small">@_ersatzTvActionError</div>
                            }
                            @foreach (var channel in _ersatzTv.Channels)
                            {
                                <div class="media-session">
                                    <div class="d-flex justify-content-between align-items-baseline gap-2">
                                        <span class="text-truncate">
                                            <span class="badge bg-secondary">@channel.Number</span>
                                            <span class="fw-semibold">@(channel.IsStreaming ? "▶ " : "")@channel.Name</span>
                                        </span>
                                        <span class="text-nowrap">
                                            @if (channel.IsStreaming)
                                            {
                                                <button type="button" class="req-btn decline" title="Stop the transcode for this channel"
                                                        disabled="@_ersatzTvActionBusy" @onclick="() => StopErsatzTvSessionAsync(channel)">✗ stop</button>
                                            }
                                            @if (_confirmPlayoutReset == channel.Number)
                                            {
                                                <button type="button" class="req-btn decline" disabled="@_ersatzTvActionBusy"
                                                        @onclick="() => ResetPlayoutAsync(channel)">confirm: rebuild playout</button>
                                            }
                                            else
                                            {
                                                <button type="button" class="req-btn approve" title="Rebuild this channel's playout from its schedule"
                                                        disabled="@_ersatzTvActionBusy" @onclick="() => _confirmPlayoutReset = channel.Number">🔁</button>
                                            }
                                        </span>
                                    </div>
                                    @if (channel.Now is { } airing)
                                    {
                                        <div class="text-muted small text-truncate" title="@airing.Describe()">@airing.Describe(channel.Name)</div>
                                        <div class="progress media-progress" role="progressbar" aria-label="Programme progress"
                                             aria-valuenow="@((int)airing.ProgressPercent)" aria-valuemin="0" aria-valuemax="100">
                                            <div class="progress-bar bg-success" style="width: @((int)airing.ProgressPercent)%"></div>
                                        </div>
                                        <div class="text-muted small text-truncate">
                                            @Format.ShortDuration(airing.Remaining) left
                                            @(channel.Next is { } next ? $" · next {next.Start:HH:mm} {next.Describe(channel.Name)}" : "")
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-muted small">
                                            @(_ersatzTv.DetailError is null ? "Nothing scheduled right now." : "—")
                                            @(channel.StreamingMode is { Length: > 0 } mode ? $" · {mode}" : "")
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        }
        @if (Hub.SonarrConfigured)
        {
            <div class="col-lg-4">
                <div class="card h-100">
                    <div class="card-header">📺 Upcoming episodes (7 days)</div>
                    <div class="card-body">
                        @if (_tv is null)
                        {
                            <span class="text-muted">Loading…</span>
                        }
                        else if (_tv.SonarrError is not null)
                        {
                            <span class="text-danger small">Sonarr: @_tv.SonarrError</span>
                        }
                        else if (_tv.Items.Count == 0)
                        {
                            <span class="text-muted">Nothing airing this week.</span>
                        }
                        else
                        {
                            @foreach (var i in _tv.Items)
                            {
                                <div class="media-upcoming">
                                    <div class="d-flex justify-content-between gap-2">
                                        <span class="fw-semibold text-truncate">@i.Title</span>
                                        <span class="text-muted small text-nowrap">@UpcomingDate(i.At)</span>
                                    </div>
                                    <div class="text-muted small text-truncate">@(i.HasFile ? "✔ " : "")@i.Detail</div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        }
        @if (Hub.RadarrConfigured)
        {
            <div class="col-lg-4">
                <div class="card h-100">
                    <div class="card-header">🎞️ Upcoming movies (30 days)</div>
                    <div class="card-body">
                        @if (_movies is null)
                        {
                            <span class="text-muted">Loading…</span>
                        }
                        else if (_movies.RadarrError is not null)
                        {
                            <span class="text-danger small">Radarr: @_movies.RadarrError</span>
                        }
                        else if (_movies.Items.Count == 0)
                        {
                            <span class="text-muted">No releases this month.</span>
                        }
                        else
                        {
                            @foreach (var i in _movies.Items)
                            {
                                <div class="media-upcoming">
                                    <div class="d-flex justify-content-between gap-2">
                                        <span class="fw-semibold text-truncate">@i.Title</span>
                                        <span class="text-muted small text-nowrap">@UpcomingDate(i.At)</span>
                                    </div>
                                    <div class="text-muted small">@(i.HasFile ? "✔ " : "")@i.Detail</div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        }
        @if (Hub.PlexConfigured)
        {
            <div class="col-lg-4">
                <div class="card h-100">
                    <div class="card-header">🆕 Recently added</div>
                    <div class="card-body">
                        @if (_recent is null)
                        {
                            <span class="text-muted">Loading…</span>
                        }
                        else if (_recent.Error is not null)
                        {
                            <span class="text-danger small">Plex: @_recent.Error</span>
                        }
                        else if (_recent.Items.Count == 0)
                        {
                            <span class="text-muted">Nothing new lately.</span>
                        }
                        else
                        {
                            @foreach (var i in _recent.Items)
                            {
                                <div class="media-upcoming">
                                    <div class="d-flex justify-content-between gap-2">
                                        <span class="fw-semibold text-truncate">@i.Title</span>
                                        <span class="text-muted small text-nowrap">@Format.ShortDuration(DateTimeOffset.Now - i.AddedAt) ago</span>
                                    </div>
                                    <div class="text-muted small text-truncate">@i.Detail</div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        }
        @if (Hub.OverseerrConfigured)
        {
            <div class="col-lg-4">
                <div class="card h-100">
                    <div class="card-header">🎟️ Pending requests</div>
                    <div class="card-body">
                        @if (_requests is null)
                        {
                            <span class="text-muted">Loading…</span>
                        }
                        else if (_requests.Error is not null)
                        {
                            <span class="text-danger small">Overseerr: @_requests.Error</span>
                        }
                        else if (_requests.Requests.Count == 0)
                        {
                            <span class="text-muted">No pending requests. 🎉</span>
                        }
                        else
                        {
                            @if (_requestActionError is not null)
                            {
                                <div class="text-danger small">@_requestActionError</div>
                            }
                            @foreach (var r in _requests.Requests)
                            {
                                <div class="media-upcoming">
                                    <div class="d-flex justify-content-between gap-2">
                                        <span class="fw-semibold text-truncate">@r.Title</span>
                                        <span class="badge bg-secondary">@r.Type</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center gap-2">
                                        <span class="text-muted small">@r.RequestedBy · @r.At.ToString("MMM d")</span>
                                        <span class="text-nowrap">
                                            <button type="button" class="req-btn approve" disabled="@_requestActionBusy"
                                                    @onclick="() => ResolveRequestAsync(r, true)">✓ approve</button>
                                            <button type="button" class="req-btn decline" disabled="@_requestActionBusy"
                                                    @onclick="() => ResolveRequestAsync(r, false)">✗</button>
                                        </span>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        }
        @if (Hub.ProwlarrConfigured)
        {
            <div class="col-lg-4">
                <div class="card h-100">
                    <div class="card-header">🕵️ Indexers</div>
                    <div class="card-body">
                        @if (_indexers is null)
                        {
                            <span class="text-muted">Loading…</span>
                        }
                        else if (_indexers.Error is not null)
                        {
                            <span class="text-danger small">Prowlarr: @_indexers.Error</span>
                        }
                        else if (_indexers.Messages.Count == 0)
                        {
                            <span class="state-up">✓ All indexers healthy</span>
                        }
                        else
                        {
                            @foreach (var (type, message) in _indexers.Messages)
                            {
                                <div class="small @(type == "error" ? "state-down" : "state-warn")">
                                    @(type == "error" ? "✗" : "⚠") @message
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        }
        @if (Hub.MissingConfigured)
        {
            <div class="col-12"><h4 class="mb-0 mt-2">Gaps in the library</h4></div>
            @if (_missingActionError is not null)
            {
                <div class="col-12"><span class="text-danger small">@_missingActionError</span></div>
            }
            @if (Hub.RadarrConfigured)
            {
                <div class="col-lg-4">
                    <div class="card h-100">
                        <div class="card-header d-flex justify-content-between">
                            <span>🎬 Missing movies</span>
                            @if (_missing is { TotalMissingMovies: > 0 } m)
                            {
                                <span class="text-muted small">@m.TotalMissingMovies wanted</span>
                            }
                        </div>
                        <div class="card-body missing-list">
                            @if (_missing is null)
                            {
                                <span class="text-muted">Loading…</span>
                            }
                            else if (_missing.RadarrError is not null)
                            {
                                <span class="text-danger small">Radarr: @_missing.RadarrError</span>
                            }
                            else if (_missing.Movies.Count == 0)
                            {
                                <span class="text-muted">Every monitored movie is on disk. 🎉</span>
                            }
                            else
                            {
                                @foreach (var movie in _missing.Movies)
                                {
                                    <div class="media-upcoming">
                                        <div class="d-flex justify-content-between align-items-center gap-2">
                                            <span class="fw-semibold text-truncate" title="@movie.Title">
                                                @movie.Title @(movie.Year is { } y ? $"({y})" : "")
                                            </span>
                                            <span class="text-nowrap">
                                                @if (_actedOn.Contains(movie.Key))
                                                {
                                                    <span class="badge bg-success">searching ✓</span>
                                                }
                                                else
                                                {
                                                    <button type="button" class="req-btn approve" title="Ask Radarr to search for this movie now"
                                                            disabled="@_missingActionBusy" @onclick="() => SearchMissingMovieAsync(movie)">🔍 search</button>
                                                }
                                            </span>
                                        </div>
                                        <div class="text-muted small">
                                            @(movie.IsAvailable ? "available" : "not released yet")
                                            @(movie.ReleasedAt is { } at ? $" · {at:MMM yyyy}" : "")
                                        </div>
                                    </div>
                                }
                                @if (_missing.TotalMissingMovies > _missing.Movies.Count)
                                {
                                    <div class="text-muted small mt-2">
                                        Showing @_missing.Movies.Count of @_missing.TotalMissingMovies — see Radarr for the rest.
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            }
            @if (Hub.SonarrConfigured)
            {
                <div class="col-lg-4">
                    <div class="card h-100">
                        <div class="card-header d-flex justify-content-between">
                            <span>📺 Missing episodes</span>
                            @if (_missing is { TotalMissingEpisodes: > 0 } s)
                            {
                                <span class="text-muted small">@s.TotalMissingEpisodes wanted</span>
                            }
                        </div>
                        <div class="card-body missing-list">
                            @if (_missing is null)
                            {
                                <span class="text-muted">Loading…</span>
                            }
                            else if (_missing.SonarrError is not null)
                            {
                                <span class="text-danger small">Sonarr: @_missing.SonarrError</span>
                            }
                            else if (_missing.Seasons.Count == 0)
                            {
                                <span class="text-muted">Every aired episode is on disk. 🎉</span>
                            }
                            else
                            {
                                var shownEpisodes = _missing.Seasons.Sum(s => s.EpisodeCount);
                                @foreach (var season in _missing.Seasons)
                                {
                                    <div class="media-upcoming">
                                        <div class="d-flex justify-content-between align-items-center gap-2">
                                            <span class="fw-semibold text-truncate" title="@season.Series">@season.Series</span>
                                            <span class="text-nowrap">
                                                @if (_actedOn.Contains(season.Key))
                                                {
                                                    <span class="badge bg-success">searching ✓</span>
                                                }
                                                else
                                                {
                                                    <button type="button" class="req-btn approve" title="Ask Sonarr to search this whole season now"
                                                            disabled="@_missingActionBusy" @onclick="() => SearchMissingSeasonAsync(season)">🔍 season</button>
                                                }
                                            </span>
                                        </div>
                                        <div class="text-muted small text-truncate" title="@season.Episodes">
                                            @(season.SeasonNumber == 0 ? "Specials" : $"S{season.SeasonNumber:00}")
                                            · @season.EpisodeCount missing · @season.Episodes
                                        </div>
                                    </div>
                                }
                                @if (_missing.TotalMissingEpisodes > shownEpisodes)
                                {
                                    <div class="text-muted small mt-2">
                                        Showing the @shownEpisodes most recent of @_missing.TotalMissingEpisodes — see Sonarr for the rest.
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            }
            @if (Hub.RadarrConfigured)
            {
                <div class="col-lg-4">
                    <div class="card h-100">
                        <div class="card-header d-flex justify-content-between">
                            <span>🗂️ Incomplete collections</span>
                            @if (_missing is { Collections.Count: > 0 } c)
                            {
                                <span class="text-muted small">@c.Collections.Count</span>
                            }
                        </div>
                        <div class="card-body missing-list">
                            @if (_missing is null)
                            {
                                <span class="text-muted">Loading…</span>
                            }
                            else if (_missing.CollectionsError is not null)
                            {
                                <span class="text-danger small">Radarr: @_missing.CollectionsError</span>
                            }
                            else if (_missing.Collections.Count == 0)
                            {
                                <span class="text-muted">No half-finished collections. 🎉</span>
                            }
                            else
                            {
                                @if (_arr.TryGetValue("Radarr", out var target))
                                {
                                    @if (target.Targets is null)
                                    {
                                        <div class="text-muted small">loading folders…</div>
                                    }
                                    else if (target.Targets.Error is { } targetError)
                                    {
                                        <div class="text-danger small">@targetError</div>
                                    }
                                    else
                                    {
                                        <div class="d-flex flex-wrap gap-2 mb-2">
                                            <select class="form-select form-select-sm dl-add-target" aria-label="Root folder" @bind="target.Root">
                                                @foreach (var folder in target.Targets.RootFolders)
                                                {
                                                    <option value="@folder">@folder</option>
                                                }
                                            </select>
                                            <select class="form-select form-select-sm dl-add-target" aria-label="Quality profile" @bind="target.ProfileId">
                                                @foreach (var profile in target.Targets.QualityProfiles)
                                                {
                                                    <option value="@profile.Id">@profile.Name</option>
                                                }
                                            </select>
                                        </div>
                                    }
                                }
                                @foreach (var collection in _missing.Collections)
                                {
                                    <div class="search-group">
                                        <div class="search-group-head d-flex justify-content-between gap-2">
                                            <span class="fw-semibold small text-truncate" title="@collection.Title">@collection.Title</span>
                                            <span class="small text-nowrap">@collection.OwnedCount of @(collection.OwnedCount + collection.Missing.Count)</span>
                                        </div>
                                        @foreach (var film in collection.Missing)
                                        {
                                            <div class="media-upcoming d-flex justify-content-between align-items-center gap-2">
                                                <span class="text-truncate" title="@film.Title">
                                                    @film.Title <span class="text-muted">@(film.Year is { } fy ? $"({fy})" : "")</span>
                                                </span>
                                                <span class="text-nowrap">
                                                    @if (_actedOn.Contains(film.Key))
                                                    {
                                                        <span class="badge bg-success">added ✓</span>
                                                    }
                                                    else
                                                    {
                                                        <button type="button" class="req-btn approve" title="Add to Radarr, monitored, and search for it now"
                                                                disabled="@(_missingActionBusy || !CanAdd("Radarr"))"
                                                                @onclick="() => AddCollectionMovieAsync(film)">+ add</button>
                                                    }
                                                </span>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            }
        }
        @if (Hub.TautulliConfigured)
        {
            <div class="col-12"><h4 class="mb-0 mt-2">Watch statistics (30 days)</h4></div>
            @if (_watchStats is null)
            {
                <div class="col-12"><span class="text-muted">Loading…</span></div>
            }
            else if (_watchStats.Error is not null)
            {
                <div class="col-12"><span class="text-danger small">Tautulli: @_watchStats.Error</span></div>
            }
            else
            {
                @if (_watchStats.Days.Count >= 2)
                {
                    <div class="col-lg-6">
                        <LineChart Title="📊 Plays per day" Unit=" plays" TickFormat="0" WideRange="true"
                                   Times="_watchStats.Days" Series="_watchSeries" />
                    </div>
                }
                <div class="col-lg-2 col-md-4">
                    <div class="card h-100">
                        <div class="card-header">📺 Top shows</div>
                        <div class="card-body">
                            @foreach (var e in _watchStats.TopShows)
                            {
                                <div class="d-flex justify-content-between gap-2 small">
                                    <span class="text-truncate">@e.Name</span><span class="text-muted">@e.Plays</span>
                                </div>
                            }
                            @if (_watchStats.TopShows.Count == 0)
                            {
                                <span class="text-muted small">No plays yet.</span>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-lg-2 col-md-4">
                    <div class="card h-100">
                        <div class="card-header">🎬 Top movies</div>
                        <div class="card-body">
                            @foreach (var e in _watchStats.TopMovies)
                            {
                                <div class="d-flex justify-content-between gap-2 small">
                                    <span class="text-truncate">@e.Name</span><span class="text-muted">@e.Plays</span>
                                </div>
                            }
                            @if (_watchStats.TopMovies.Count == 0)
                            {
                                <span class="text-muted small">No plays yet.</span>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-lg-2 col-md-4">
                    <div class="card h-100">
                        <div class="card-header">👤 Top users</div>
                        <div class="card-body">
                            @foreach (var e in _watchStats.TopUsers)
                            {
                                <div class="d-flex justify-content-between gap-2 small">
                                    <span class="text-truncate">@e.Name</span><span class="text-muted">@e.Plays</span>
                                </div>
                            }
                            @if (_watchStats.TopUsers.Count == 0)
                            {
                                <span class="text-muted small">No plays yet.</span>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
}

@code {
    private NowPlayingSnapshot? _nowPlaying;
    private DownloadsSnapshot? _downloads;
    private UpcomingSnapshot? _tv;
    private UpcomingSnapshot? _movies;
    private RequestsSnapshot? _requests;
    private RecentlyAddedSnapshot? _recent;
    private QueueSnapshot? _queue;
    private WatchStatsSnapshot? _watchStats;
    private IReadOnlyList<(string, IReadOnlyList<double?>)> _watchSeries = [];
    private bool _downloadActionBusy;
    private string? _downloadActionError;
    private string? _confirmRetry;
    private bool _queueActionBusy;
    private string? _queueActionError;
    private bool _requestActionBusy;
    private string? _requestActionError;
    private IndexerHealthSnapshot? _indexers;
    private ErsatzTvSnapshot? _ersatzTv;
    private bool _ersatzTvActionBusy;
    private string? _ersatzTvActionError;
    private string? _confirmPlayoutReset;
    private MissingSnapshot? _missing;
    private bool _missingActionBusy;
    private string? _missingActionError;
    private string _searchQuery = "";
    private string _lastQuery = "";
    private bool _searching;
    private SearchSnapshot? _search;
    private bool _searchActionBusy;
    private string? _searchActionError;
    /// <summary>Keys of results already requested/added this visit, so the row stops offering it.</summary>
    private readonly HashSet<string> _actedOn = [];
    /// <summary>Where an "+ add" lands, per Arr. Loaded lazily when a search returns its hits.</summary>
    private readonly Dictionary<string, ArrTargetChoice> _arr = new();
    private string? _confirmKill;
    private string? _killError;
    private string _addLink = "";
    private string _addTarget = "auto";
    private bool _adding;
    private bool _added;
    private string? _addError;
    private Timer? _refreshTimer;

    // Data loads after first render so prerendering never blocks on the media stack.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        await LoadAsync();
        StateHasChanged();
        _refreshTimer = new Timer(_ => _ = InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        }), null, TimeSpan.FromSeconds(15), TimeSpan.FromSeconds(15));
    }

    // The hub caches per source (10s live / 5min calendars), so refreshing
    // everything on one timer is cheap. Each card renders the moment its own
    // source answers — one slow service never blanks the rest of the page.
    private Task LoadAsync()
    {
        var tasks = new List<Task>();
        if (Hub.TautulliConfigured)
            tasks.Add(AssignAsync(Hub.GetNowPlayingAsync(), v => _nowPlaying = v));
        if (Hub.DownloadsConfigured)
            tasks.Add(AssignAsync(Hub.GetDownloadsAsync(), v => _downloads = v));
        if (Hub.SonarrConfigured)
            tasks.Add(AssignAsync(Hub.GetUpcomingTvAsync(), v => _tv = v));
        if (Hub.RadarrConfigured)
            tasks.Add(AssignAsync(Hub.GetUpcomingMoviesAsync(), v => _movies = v));
        if (Hub.OverseerrConfigured)
            tasks.Add(AssignAsync(Hub.GetRequestsAsync(), v => _requests = v));
        if (Hub.PlexConfigured)
            tasks.Add(AssignAsync(Hub.GetRecentlyAddedAsync(), v => _recent = v));
        if (Hub.SonarrConfigured || Hub.RadarrConfigured)
            tasks.Add(AssignAsync(Hub.GetQueueAsync(), v => _queue = v));
        if (Hub.TautulliConfigured)
            tasks.Add(AssignAsync(Hub.GetWatchStatsAsync(), v =>
            {
                _watchStats = v;
                _watchSeries = [("TV", v.TvPlays), ("Movies", v.MoviePlays)];
            }));
        if (Hub.ProwlarrConfigured)
            tasks.Add(AssignAsync(Hub.GetIndexerHealthAsync(), v => _indexers = v));
        if (Hub.ErsatzTvConfigured)
            tasks.Add(AssignAsync(Hub.GetErsatzTvAsync(), v => _ersatzTv = v));
        if (Hub.MissingConfigured)
            tasks.Add(AssignAsync(Hub.GetMissingAsync(), v =>
            {
                _missing = v;
                // Closing a collection gap adds to Radarr, so that card needs the
                // same root folder / quality profile pickers the search results use.
                if (v.Collections.Count > 0)
                    _ = EnsureArrTargetsAsync(["Radarr"]);
            }));
        return Task.WhenAll(tasks);
    }

    // The hub converts source failures into per-card Error values, but if anything
    // slips through, swallow it here — a faulted load must never kill the circuit
    // and freeze every card at "Loading".
    private async Task AssignAsync<T>(Task<T> fetch, Action<T> setter)
    {
        try
        {
            setter(await fetch);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Media card load failed");
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task TogglePauseAsync(DownloadItem item)
    {
        _downloadActionBusy = true;
        _downloadActionError = null;
        try
        {
            await Hub.SetDownloadPausedAsync(item, !item.IsPaused);
            _downloads = await Hub.GetDownloadsAsync();
        }
        catch (Exception ex)
        {
            _downloadActionError = $"{item.Source}: {ex.GetBaseException().Message}";
        }
        finally
        {
            _downloadActionBusy = false;
        }
    }

    private async Task RetryQueueItemAsync(QueueItem item)
    {
        _confirmRetry = null;
        _queueActionBusy = true;
        _queueActionError = null;
        try
        {
            await Hub.RetryQueueItemAsync(item);
            _queue = await Hub.GetQueueAsync();
        }
        catch (Exception ex)
        {
            _queueActionError = $"{item.Source}: {ex.GetBaseException().Message}";
        }
        finally
        {
            _queueActionBusy = false;
        }
    }

    private async Task KillStreamAsync(PlexSession session)
    {
        _confirmKill = null;
        _killError = null;
        try
        {
            await Hub.TerminateSessionAsync(session.SessionKey);
            _nowPlaying = await Hub.GetNowPlayingAsync();
        }
        catch (Exception ex)
        {
            _killError = ex.GetBaseException().Message;
        }
    }

    private async Task AddDownloadAsync()
    {
        _adding = true;
        _added = false;
        _addError = null;
        var link = _addLink.Trim();
        var target = _addTarget switch
        {
            "auto" => link.StartsWith("magnet:", StringComparison.OrdinalIgnoreCase)
                      || link.Contains(".torrent", StringComparison.OrdinalIgnoreCase)
                ? "qBittorrent"
                : "NZBGet",
            var t => t,
        };
        try
        {
            await Hub.AddDownloadAsync(link, target);
            _added = true;
            _addLink = "";
            _downloads = await Hub.GetDownloadsAsync();
        }
        catch (Exception ex)
        {
            _addError = $"{target}: {ex.GetBaseException().Message}";
        }
        finally
        {
            _adding = false;
        }
    }

    private Task OnSearchKeyDown(KeyboardEventArgs e) =>
        e.Key == "Enter" && !string.IsNullOrWhiteSpace(_searchQuery) ? SearchAsync() : Task.CompletedTask;

    private async Task SearchAsync()
    {
        _searching = true;
        _searchActionError = null;
        _lastQuery = _searchQuery.Trim();
        try
        {
            _search = await Hub.SearchAsync(_lastQuery);
        }
        catch (Exception ex)
        {
            _search = new SearchSnapshot { Errors = [ex.GetBaseException().Message] };
        }
        finally
        {
            _searching = false;
        }
        await LoadArrTargetsAsync();
    }

    // Root folders and quality profiles are only needed once an Arr actually
    // returns something addable, so they are fetched after the search, not before.
    private Task LoadArrTargetsAsync() =>
        _search is null
            ? Task.CompletedTask
            : EnsureArrTargetsAsync(_search.Results.Select(r => r.Source).Where(s => s is "Radarr" or "Sonarr"));

    private async Task EnsureArrTargetsAsync(IEnumerable<string> sources)
    {
        var wanted = sources.Distinct().Where(s => !_arr.ContainsKey(s)).ToList();
        if (wanted.Count == 0)
            return;
        foreach (var source in wanted)
            _arr[source] = new ArrTargetChoice();
        await Task.WhenAll(wanted.Select(async source =>
        {
            var targets = await Hub.GetArrTargetsAsync(source);
            var choice = _arr[source];
            choice.Targets = targets;
            choice.Root = targets.RootFolders.FirstOrDefault() ?? "";
            choice.ProfileId = targets.QualityProfiles.FirstOrDefault()?.Id ?? 0;
            await InvokeAsync(StateHasChanged);
        }));
    }

    private bool CanAdd(SearchResult result) => CanAdd(result.Source);

    private bool CanAdd(string source) =>
        _arr.TryGetValue(source, out var choice) && choice.Root.Length > 0 && choice.ProfileId > 0;

    private async Task AddToArrAsync(SearchResult result)
    {
        _searchActionBusy = true;
        _searchActionError = null;
        try
        {
            var choice = _arr[result.Source];
            await Hub.AddToArrAsync(result, choice.Root, choice.ProfileId);
            _actedOn.Add(result.Key);
            _queue = await Hub.GetQueueAsync();
        }
        catch (Exception ex)
        {
            _searchActionError = $"{result.Source}: {ex.GetBaseException().Message}";
        }
        finally
        {
            _searchActionBusy = false;
        }
    }

    private async Task RequestAsync(SearchResult result)
    {
        _searchActionBusy = true;
        _searchActionError = null;
        try
        {
            await Hub.SubmitRequestAsync(result.ExternalId, result.Type);
            _actedOn.Add(result.Key);
            _requests = await Hub.GetRequestsAsync();
        }
        catch (Exception ex)
        {
            _searchActionError = ex.GetBaseException().Message;
        }
        finally
        {
            _searchActionBusy = false;
        }
    }

    private Task SearchMissingMovieAsync(MissingMovie movie) =>
        RunMissingActionAsync(movie.Key, "Radarr", () => Hub.SearchForMissingAsync("Radarr", movie.MovieId));

    private Task SearchMissingSeasonAsync(MissingSeason season) =>
        RunMissingActionAsync(season.Key, "Sonarr", () => Hub.SearchForMissingAsync("Sonarr", season.SeriesId, season.SeasonNumber));

    private Task AddCollectionMovieAsync(CollectionMovie film)
    {
        var choice = _arr["Radarr"];
        return RunMissingActionAsync(film.Key, "Radarr", () => Hub.AddMovieByTmdbAsync(film.TmdbId, choice.Root, choice.ProfileId));
    }

    // The three gap cards act the same way: run it, mark the row done, refresh the
    // queue so whatever the Arr grabs shows up without waiting for the next tick.
    private async Task RunMissingActionAsync(string key, string source, Func<Task> action)
    {
        _missingActionBusy = true;
        _missingActionError = null;
        try
        {
            await action();
            _actedOn.Add(key);
            _queue = await Hub.GetQueueAsync();
        }
        catch (Exception ex)
        {
            _missingActionError = $"{source}: {ex.GetBaseException().Message}";
        }
        finally
        {
            _missingActionBusy = false;
        }
    }

    private Task StopErsatzTvSessionAsync(ErsatzTvChannel channel) =>
        RunErsatzTvActionAsync(() => Hub.StopErsatzTvSessionAsync(channel.Number), channel);

    private Task ResetPlayoutAsync(ErsatzTvChannel channel) =>
        RunErsatzTvActionAsync(() => Hub.ResetErsatzTvPlayoutAsync(channel.Number), channel);

    // Both channel actions change what ErsatzTV is doing right now, so the card is
    // re-read straight away rather than waiting out the refresh tick.
    private async Task RunErsatzTvActionAsync(Func<Task> action, ErsatzTvChannel channel)
    {
        _confirmPlayoutReset = null;
        _ersatzTvActionBusy = true;
        _ersatzTvActionError = null;
        try
        {
            await action();
            _ersatzTv = await Hub.GetErsatzTvAsync();
        }
        catch (Exception ex)
        {
            _ersatzTvActionError = $"ErsatzTV channel {channel.Number}: {ex.GetBaseException().Message}";
        }
        finally
        {
            _ersatzTvActionBusy = false;
        }
    }

    private static int SourceOrder(string source) => source switch { "Overseerr" => 0, "Radarr" => 1, _ => 2 };

    private static string SourceIcon(string source) => source switch { "Overseerr" => "🎟️", "Radarr" => "🎞️", _ => "📺" };

    /// <summary>The root folder and quality profile an "+ add" from one Arr will use.</summary>
    private sealed class ArrTargetChoice
    {
        public ArrTargets? Targets;
        public string Root = "";
        public int ProfileId;
    }

    private async Task ResolveRequestAsync(MediaRequest request, bool approve)
    {
        _requestActionBusy = true;
        _requestActionError = null;
        try
        {
            await Hub.ResolveRequestAsync(request.Id, approve);
            _requests = await Hub.GetRequestsAsync();
        }
        catch (Exception ex)
        {
            _requestActionError = ex.GetBaseException().Message;
        }
        finally
        {
            _requestActionBusy = false;
        }
    }

    private static string UpcomingDate(DateTimeOffset at) =>
        at.Date == DateTime.Today ? $"today {at:HH:mm}"
        : at.Date == DateTime.Today.AddDays(1) ? $"tomorrow {at:HH:mm}"
        : at.ToString("ddd MMM d");

    public void Dispose() => _refreshTimer?.Dispose();
}
