# Copy to .env (same folder as docker-compose.yml) and fill in.
# docker compose reads it automatically; never commit the real .env.

# Your timezone (IANA name) — without it the container runs on UTC and all
# displayed times (weather, clock, charts) are off.
TZ=America/New_York
# Labby login. Leave the password empty to run without a login screen (open on your LAN).
LABBY_AUTH_USERNAME=labby
LABBY_AUTH_PASSWORD=

# Optional CI deploy hook. Set to a long random string (e.g. `openssl rand -hex 32`)
# to enable POST /api/deploy, which runs the same self-update as the Settings page.
# Use the same value for the LABBY_DEPLOY_TOKEN GitHub secret; empty = endpoint off.
LABBY_DEPLOY_TOKEN=

# Optional webhook for service down/recovery alerts.
# ntfy: https://ntfy.sh/your-topic — Discord/Slack: paste the webhook URL.
LABBY_ALERT_WEBHOOK=

# Optional Pushover push notifications (create an application at pushover.net/apps/build
# for the token; your user key is on the pushover.net dashboard). Set both to enable.
LABBY_PUSHOVER_TOKEN=
LABBY_PUSHOVER_USER=

# Good-morning digest hour (0-23), e.g. 8; empty = off
LABBY_DIGEST_HOUR=

QNAP_HOST=192.168.1.50
QNAP_PORT=8080
QNAP_USE_HTTPS=false
QNAP_USERNAME=labby
QNAP_PASSWORD=
AMBIENT_API_KEY=
AMBIENT_APP_KEY=
AMBIENT_DEVICE_MAC=

# Kontainr (embedded on the Containers page). The URL is loaded by YOUR BROWSER,
# so use the machine's LAN IP if you access Labby from other devices.
KONTAINR_URL=http://localhost:5124
KONTAINR_AUTH_USERNAME=
KONTAINR_AUTH_PASSWORD=

# Optional web terminal (e.g. a web-SSH container) embedded on the Terminal page.
# Browser-loaded iframe URL, so it must resolve from your devices.
TERMINAL_URL=

# Optional code-server / VS Code Web embedded on the VS Code page.
# Browser-loaded iframe URL, so it must resolve from your devices.
VSCODE_URL=

# Optional OSINT Hub (github.com/chrisdfennell/OSINT) embedded on the OSINT page.
# Browser-loaded iframe URL, so it must resolve from your devices, e.g. http://nas:3000
OSINT_URL=

# Optional Christmas wishlist app embedded on the Wishlist page.
# Browser-loaded iframe URL, so it must resolve from your devices, e.g. http://nas:54321
# If you reach Labby over https (a Cloudflare hostname, say), this has to be https too:
# a browser will not put a plain-http frame inside an https page, and Cloudflare's
# Automatic HTTPS Rewrites turns the http:// URL into one the app cannot answer.
# Add ?token=... here when the wishlist has WISHLIST_TOKEN set.
WISHLIST_URL=

# Optional MyPersonalGit (github.com/chrisdfennell/MyPersonalGit) for the Git page + dashboard card.
# URL is loaded by the Labby SERVER (API calls), so a container-reachable address is fine.
# Token is a personal access token ("mypg_…") from Settings → Tokens in MyPersonalGit.
MYPERSONALGIT_URL=
MYPERSONALGIT_TOKEN=

# Media page (all optional — configured sources get a card, the rest are hidden).
PLEX_BASE_URL=
PLEX_TOKEN=
TAUTULLI_BASE_URL=
TAUTULLI_API_KEY=
SONARR_BASE_URL=
SONARR_API_KEY=
RADARR_BASE_URL=
RADARR_API_KEY=
OVERSEERR_BASE_URL=
OVERSEERR_API_KEY=
QBITTORRENT_BASE_URL=
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=
NZBGET_BASE_URL=
NZBGET_USERNAME=
NZBGET_PASSWORD=
PROWLARR_BASE_URL=
PROWLARR_API_KEY=
